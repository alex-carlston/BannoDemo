# =============================================================================
# Banno Pulse — copy to `.env` and fill real values before deploy
# =============================================================================
#   cp .env.example .env
#   # edit .env — set CLIENT_ID, CLIENT_SECRET, and both secrets
#   ./quickstart.sh
#
# Never commit `.env`.
# =============================================================================

# --- Cloudflare (leave empty for interactive wrangler login) ----------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Jack Henry / Banno (required) ------------------------------------------
# Dashboard: https://jackhenry.dev/portal/dashboard
# Guide:     https://jackhenry.dev/open-api-docs/getting-started/
CLIENT_ID=
CLIENT_SECRET=
ENV_URI=https://digital.garden-fi.com
# Leave empty on first deploy — quickstart sets …/callback/plugin after deploy
REDIRECT_URI=

# --- App secrets (required — two DIFFERENT values) --------------------------
# Generate:  openssl rand -base64 32
SESSION_ENC_SECRET=
COOKIE_SIGNING_SECRET=
