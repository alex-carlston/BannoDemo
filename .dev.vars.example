# Copy to `.dev.vars` for **host** local Wrangler (`npm run dev`) only.
# Get CLIENT_ID / CLIENT_SECRET from the Jack Henry dashboard (external application).
#
# Docker quickstart uses a different file: copy `.env.example` → `.env`
# (see docs/setup-docker.md). Do not mix the two unless you intentionally sync.
#
# Windows host setup: .\scripts\setup.ps1   |   macOS/Linux: ./scripts/setup.sh

CLIENT_ID=your-client-id-from-banno-admin
CLIENT_SECRET=your-client-secret-from-banno-admin
ENV_URI=https://digital.garden-fi.com
REDIRECT_URI=http://localhost:8787/callback/plugin

# Generate with: openssl rand -base64 32  (two DIFFERENT values)
SESSION_ENC_SECRET=replace-with-openssl-rand-base64-32
COOKIE_SIGNING_SECRET=replace-with-different-openssl-rand-base64-32
ENVIRONMENT=development
